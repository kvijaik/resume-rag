# Copy this file to .env and fill in your own values.

# Required for real (non-demo) usage.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown).
CHAT_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small
LLM_TEMPERATURE=0
TOP_K=3
MIN_SIMILARITY_SCORE=0.35
MIN_QUERY_WORDS=3

# Set to 1 ONLY to run the app fully offline with local stub embeddings/LLM
# (used to generate demo screenshots when no OpenAI key is available).
DEMO_MODE=0
